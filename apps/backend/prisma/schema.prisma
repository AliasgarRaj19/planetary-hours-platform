generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppPlatform {
  android
}

enum AppDistributionMode {
  direct_apk
  google_play
}

enum BlogArticleStatus {
  draft
  published
  unpublished
}

enum AuditLogResult {
  success
  failure
}

model PlanetaryHourContent {
  id          Int      @id @default(autoincrement())
  dayOfWeek   Int
  hourNumber  Int
  description String   @default("")
  suggestion  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayOfWeek, hourNumber])
}

model AppDistribution {
  id         Int                     @id @default(autoincrement())
  platform   AppPlatform             @unique
  activeMode AppDistributionMode
  storeUrl   String?
  isEnabled  Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  artifacts  AppDistributionArtifact[]
}

model AppDistributionArtifact {
  id               Int             @id @default(autoincrement())
  distributionId   Int
  distribution     AppDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  publicUrl        String
  checksumSha256   String
  versionName      String?
  versionCode      Int?
  createdAt        DateTime        @default(now())

  @@index([distributionId, createdAt])
}

model BlogCategory {
  id             Int                   @id @default(autoincrement())
  name           String
  slug           String                @unique
  description    String                @default("")
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  articles       BlogArticleCategory[]

  @@index([slug])
}

model BlogArticle {
  id             Int                   @id @default(autoincrement())
  title          String
  slug           String                @unique
  excerpt        String                @default("")
  bodyMarkdown   String                @default("")
  status         BlogArticleStatus     @default(draft)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  categories     BlogArticleCategory[]

  @@index([status, publishedAt])
  @@index([slug])
}

model BlogArticleCategory {
  articleId  Int
  categoryId Int
  article    BlogArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model AuditLog {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  actorType            String         @default("admin")
  actorId              String?
  actorUsername        String?
  actorDisplayName     String?
  actorRole            String?
  action               String
  module               String
  resourceType         String
  resourceId           String?
  resourceDisplayName  String?
  description          String
  result               AuditLogResult
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  requestId            String?

  @@index([createdAt])
  @@index([module, action, createdAt])
  @@index([actorId, createdAt])
  @@index([actorUsername, createdAt])
  @@index([resourceType, resourceId])
  @@index([result, createdAt])
}
